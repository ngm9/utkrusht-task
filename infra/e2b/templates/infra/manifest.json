{
  "build_cmd": "terraform init",
  "capabilities": {
    "datastores": [
      "postgres",
      "mysql",
      "mongo",
      "redis",
      "elasticsearch"
    ],
    "frameworks": [
      "terraform",
      "ansible",
      "packer",
      "docker",
      "docker-compose",
      "kubectl",
      "helm",
      "vault",
      "consul",
      "shellspec",
      "bats-core"
    ],
    "language_versions": {
      "ansible": "2.17",
      "python": "3.12",
      "terraform": "1.9"
    },
    "protocols": [
      "rest",
      "grpc",
      "websocket"
    ],
    "requires": {
      "browser": false,
      "gpu": false
    },
    "tags": [
      "infra",
      "devops",
      "terraform",
      "ansible",
      "kubernetes",
      "cloud"
    ],
    "tools": [
      "git",
      "curl",
      "wget",
      "jq",
      "yq",
      "unzip",
      "zip",
      "make",
      "build-essential",
      "ca-certificates",
      "gnupg",
      "lsb-release",
      "netcat-openbsd",
      "openssh-client",
      "rsync",
      "docker-ce",
      "docker-ce-cli",
      "containerd.io",
      "docker-buildx-plugin",
      "docker-compose-plugin",
      "docker-compose",
      "terraform",
      "packer",
      "ansible",
      "aws-cli",
      "azure-cli",
      "google-cloud-sdk",
      "kubectl",
      "helm",
      "vault",
      "consul",
      "yq",
      "shellspec",
      "bats-core",
      "python3",
      "python3-pip",
      "ttyd",
      "code-server"
    ]
  },
  "compile_cmd": "terraform validate",
  "description": "Infrastructure / DevOps runtime with Terraform, Ansible, kubectl, Helm, AWS/Azure/GCP CLIs, HashiCorp Vault & Consul, Docker-in-Docker, and shell testing harnesses (shellspec, bats-core); browser terminal via ttyd and browser IDE via code-server.",
  "eval_methods": [
    "test_suite"
  ],
  "install_cmd": "apt-get install -y gnupg software-properties-common curl && curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor > /usr/share/keyrings/hashicorp-archive-keyring.gpg && echo \"deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main\" > /etc/apt/sources.list.d/hashicorp.list && apt-get update && apt-get install -y terraform",
  "install_seconds": 60,
  "install_verify": "terraform version",
  "personas": [
    "devops_engineer",
    "platform_engineer",
    "sre",
    "cloud_engineer"
  ],
  "primary_runtime": "infra",
  "status": "built",
  "template_id": "utkrusht-infra",
  "test_cmd": "shellspec --format progress"
}
